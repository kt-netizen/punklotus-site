---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site).href;
const path = Astro.url.pathname.replace(/\/$/, '');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Punk Lotus',
  url: 'https://www.punklotus.com',
  logo: 'https://www.punklotus.com/images/punklotus-logo-white.png',
  description: 'Senior brand strategy for Australian businesses: brand foundations, strategy and set-up delivered as fixed-scope projects, remotely.',
  email: 'kt@punklotus.com',
  telephone: '+61468825419',
  founder: { '@type': 'Person', name: 'Kirsty Thompson', jobTitle: 'Brand and communications strategist', sameAs: ['https://www.linkedin.com/in/kirstythompsononline/'] },
  address: { '@type': 'PostalAddress', addressRegion: 'NSW', addressCountry: 'AU' },
  areaServed: { '@type': 'Country', name: 'Australia' },
};
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Punk Lotus" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://www.punklotus.com/images/punklotus_bg_sprocket.jpg" />
    <meta name="google-site-verification" content="VxHewMh27EQ1BcsQDKpMm467BLlGfBtVvNXT9Uv8Diw" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;700&family=Fraunces:opsz,wght,SOFT,WONK@9..144,400..800,100,1&family=Noto+Sans+Mono:wght@400;700&family=Covered+By+Your+Grace&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="logo" aria-label="Punk Lotus home">
          <img src="/images/punklotus-logo-horizontal-white.png" alt="Punk Lotus" width="900" height="240" />
        </a>
        <nav aria-label="Main">
          <a href="/about" aria-current={path === '/about' ? 'page' : undefined}>About</a>
          <a href="/brandconsulting" aria-current={path === '/brandconsulting' ? 'page' : undefined}>The Work</a>
          <a href="#contact" class="btn">Get in Touch</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap foot">
        <img src="/images/punklotus-logo-horizontal-white.png" alt="" width="900" height="240" class="foot-logo" />
        <div>
          <nav class="foot-nav" aria-label="Footer">
            <a href="/">Home</a>
            <a href="/about">About</a>
            <a href="/brandconsulting">The Work</a>
            <a href="https://www.linkedin.com/in/kirstythompsononline/" rel="noopener">LinkedIn</a>
          </nav>
          <p>Kirsty Thompson · Northern Rivers, NSW · working with businesses Australia-wide</p>
          <p><a href="mailto:kt@punklotus.com">kt@punklotus.com</a> · <a href="tel:+61468825419">0468 825 419</a></p>
          <p class="small">© {new Date().getFullYear()} Punk Lotus</p>
        </div>
      </div>
    </footer>
    <script>
      const els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) els.forEach((e) => e.classList.add('in'));
      else {
        const io = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }), { threshold: 0.12 });
        els.forEach((e) => io.observe(e));
      }
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 16px; top: 16px; z-index: 10; background: var(--orange); color: var(--black); padding: 8px 12px; }
  .site-header { background: var(--black); position: sticky; top: 0; z-index: 5; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 14px; padding-bottom: 14px; }
  .logo img { height: clamp(40px, 5.5vw, 64px); width: auto; }
  nav { display: flex; align-items: center; gap: clamp(12px, 3vw, 32px); font-family: var(--font-ui); }
  .bar nav a:not(.btn) { color: var(--white); text-decoration: none; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; font-size: .85rem; }
  .bar nav a:not(.btn):hover, .bar nav a[aria-current='page'] { color: var(--orange); }
  @media (max-width: 560px) { nav .btn { display: none; } }
  .site-footer { background: var(--orange); color: var(--black); padding: 48px 0; font-family: var(--font-ui); font-size: .95rem; }
  .foot { display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start; justify-content: space-between; }
  .foot-logo { height: 56px; width: auto; filter: brightness(0); opacity: .85; }
  .site-footer p { margin: 0 0 .4em; }
  .site-footer a { color: var(--black); }
  .foot-nav { justify-content: flex-start; flex-wrap: wrap; margin-bottom: 16px; }
  .foot-nav a { color: var(--black); font-weight: 700; text-transform: uppercase; letter-spacing: .06em; font-size: .85rem; text-decoration: none; }
  .foot-nav a:hover { text-decoration: underline; }
  .small { opacity: .75; font-size: .8rem; }
</style>
