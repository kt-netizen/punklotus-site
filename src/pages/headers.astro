---
// Internal comparison page for header backgrounds. Not linked or indexed. Delete once picked.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
const opts = [
  ['sunburst', '1. Sunburst: 70s rays turning slowly behind an orange sun'],
  ['groovy', '2. Groovy arcs: retro stripes in orange, cream and oxblood, drifting'],
  ['halftone', '3. Halftone: bold print dots sliding, plus a soft cream shape'],
  ['film', '4. Film burn (current), for comparison'],
] as const;
---
<Base title="Header options — Punk Lotus" description="Internal design test.">
  <meta name="robots" content="noindex" slot="head" />
  {opts.map(([bg, label]) => (
    <>
      <p class="tag">{label}</p>
      <Hero bg={bg} title="Senior brand strategy for businesses that know what they want." sub="Discovery, strategy, brand foundations and set-up — scoped as one project, done properly, then handed over.">
        <a class="btn" href="#">Start with a Gut-Check</a>
        <a class="btn btn--ghost" href="#">See the work</a>
      </Hero>
    </>
  ))}
</Base>
<style>
  .tag { margin: 0; padding: 12px var(--gutter); background: var(--cream); color: var(--charcoal); font-family: var(--font-ui); font-weight: 700; border-top: 6px solid var(--charcoal); }
</style>
