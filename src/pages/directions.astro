---
// Internal comparison page: oxblood/cream/orange palette in three retro heading fonts.
// Not linked or indexed. Delete once a direction is picked.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';

const dirs = [
  { id: 'a', name: 'A — Fraunces', note: 'Soft 70s serif with a deliberate wobble. Warm, literary, a bit odd.' },
  { id: 'b', name: 'B — Bricolage Grotesque', note: 'Chunky sans with off-kilter proportions. Confident, quirky, modern-retro.' },
  { id: 'c', name: 'C — Shrikhand', note: 'Full 70s display. Loudest and most retro; headings only, kept short.' },
  { id: 'd', name: 'D — Handwritten accents', note: 'Fraunces headings, with handwriting (a stand-in font for now) for the asides: Start here, It’s literally my job, notes in the margin.' },
];
---
<Base title="Design directions — Punk Lotus" description="Internal design test.">
  <meta name="robots" content="noindex" slot="head" />
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,400..800,100,1&family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Shrikhand&family=Covered+By+Your+Grace&display=swap" rel="stylesheet" />

  {dirs.map((d) => (
    <div class={`dir dir-${d.id}`}>
      <p class="tag">{d.name}: {d.note}</p>
      <Hero
        title="Senior brand strategy for businesses that know what they want."
        sub="Discovery, strategy, brand foundations and set-up — scoped as one project, done properly, then handed over."
      >
        <a class="btn" href="#">Start with a Gut-Check</a>
        <a class="btn btn--ghost" href="#">See the work</a>
      </Hero>
      <Marquee items={['Brand foundations', 'Positioning', 'Messaging', 'Voice & language', 'Visual identity', 'Rebrands']} />
      <section class="section section--light">
        <div class="wrap split">
          <div><h2>Building brand foundations with strategy and style that fit.</h2></div>
          <div>
            <p>If you've outgrown your current brand, we rebrand it. If you're launching something new, we build the communication strategy to take it to market.</p>
            <p class="lede">This is about getting over the hump, and <span class="hl">getting it done.</span></p>
          </div>
        </div>
      </section>
      <section class="section section--orange">
        <div class="wrap split">
          <div><p class="eyebrow hand">Start here</p><h2>The Brand Gut-Check</h2></div>
          <div><p>Send your site and socials, get back a short, sharp read on what's working and what to fix first. $350, standalone.</p><a class="btn" href="#">Book a Gut-Check</a></div>
        </div>
      </section>
      <section class="section section--deep">
        <div class="wrap">
          <h2>It’s ok to ask for help.</h2>
          <p class="lede hand">It’s literally my job.</p>
        </div>
      </section>
    </div>
  ))}
</Base>

<style>
  /* the oxblood palette: overrides the site colours inside each sample */
  .dir {
    --black: #3B0F14;        /* deep oxblood: hero + darkest moments */
    --charcoal: #5A1A1F;     /* oxblood: text + dark sections */
    --cream: #EBD3B8;
    --cream-light: #F6EBDD;
    --orange: #F48847;
    --orange-deep: #A8441A;
    color: var(--charcoal);
    border-bottom: 12px solid #3B0F14;
  }
  .dir-a { --font-display: 'Fraunces', serif; }
  .dir-a :global(h1), .dir-a :global(h2), .dir-a :global(.lede), .dir-a :global(li) {
    font-variation-settings: 'SOFT' 100, 'WONK' 1; font-weight: 700;
  }
  .dir-b { --font-display: 'Bricolage Grotesque', sans-serif; }
  .dir-b :global(h1), .dir-b :global(h2) { font-weight: 800; letter-spacing: -.01em; }
  .dir-b :global(.lede), .dir-b :global(li) { font-weight: 700; }
  .dir-c { --font-display: 'Shrikhand', serif; }
  .dir-d { --font-display: 'Fraunces', serif; }
  .dir-d :global(h1), .dir-d :global(h2), .dir-d :global(li) { font-variation-settings: 'SOFT' 100, 'WONK' 1; font-weight: 700; }
  .dir-d .hand { font-family: 'Covered By Your Grace', cursive; font-size: clamp(1.6rem, 3.2vw, 2.4rem); text-transform: none; letter-spacing: .02em; font-weight: 400; transform: rotate(-2deg); display: inline-block; }
  .dir-d .section--orange .hand { color: var(--charcoal); }
  .dir :global(.hero) { background: var(--black); }
  .dir :global(.hero h1) { color: var(--orange); }
  .dir :global(.hero::after) { background: linear-gradient(to top, rgba(59,15,20,.85), rgba(59,15,20,0) 70%); }
  .dir :global(.film video) { filter: sepia(.6) saturate(1.4) hue-rotate(-15deg) contrast(1.3); }
  .dir :global(.marquee) { background: var(--cream); border-color: var(--charcoal); color: var(--charcoal); }
  .section--deep { background: var(--charcoal); color: var(--cream-light); }
  .section--deep h2 { color: var(--orange); }
  .tag { margin: 0; padding: 10px var(--gutter); background: #3B0F14; color: #F6EBDD; font-family: var(--font-ui); font-weight: 700; }
  .eyebrow { font-family: var(--font-ui); font-weight: 700; text-transform: uppercase; letter-spacing: .1em; margin-bottom: .4em; }
</style>
