---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import Carousel from '../components/Carousel.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import GutCheck from '../components/GutCheck.astro';

const services = [
  {
    name: 'Brand Foundations',
    body: "The strategic and creative backbone of a brand. Positioning, audience definition, messaging framework, brand voice and language, website and all aspects of visual identity (developed in collaboration with trusted designers). This is the work everything else is built on. Done properly, it keeps your branding on point across your team, your designers, and the AI tools you're already using. A brand that only lives in your head can't be briefed to anyone, human or machine. Best for new businesses building from scratch, or established ones that have never had proper foundations set.",
    deliverables: ['Brand audit and competitor research', 'Audience definition and persona development', 'Positioning, purpose and values', 'Messaging framework and key messages', 'Brand voice, tone and language', 'Naming and tagline development', 'Visual identity (developed with trusted designers)', 'Brand guidelines', 'Website strategy, sitemaps, copy and project management', 'Launch-ready content and assets'],
  },
  {
    name: 'Rebrand & Repositioning',
    body: 'For businesses that have outgrown their current expression — whether the brand has shifted, the audience has matured, or the original identity was built before the business knew what it really was. The work spans strategic repositioning, refreshed messaging and voice, and visual identity evolution. The goal is bringing the brand into alignment with where the business is now.',
    deliverables: ['Brand audit and brand health diagnostic', 'Audience and market reassessment', 'Refreshed positioning and messaging framework', 'Updated brand voice and language', 'Visual identity evolution (with trusted designers)', 'Updated brand guidelines', 'Website refresh or rebuild', 'Internal comms for rebrand rollout', 'Launch and announcement strategy for the rebrand'],
  },
  {
    name: 'Launch & Campaigns',
    body: 'Taking a brand to market or activating one that needs to move. Communications strategy, campaign development, content, email sequences, social, and PR; all built around what the brand needs to achieve. Equally suited to new launches, product releases, repositioning moments, or established brands that need a push.',
    deliverables: ['Communications strategy and campaign planning', 'Campaign creative concept and development', 'Content production (copy, social assets, video direction)', 'Email sequences and EDMs', 'Social media strategy and assets', 'PR strategy, press releases and media outreach', 'Landing pages and campaign-specific web assets', 'Cross-channel rollout and project management', 'Reporting and post-launch insights'],
  },
  {
    name: 'AI-Ready Brand Systems',
    body: 'AI needs brand foundations in a form it can actually use. I take your foundations and develop them into a structured brand system you import straight into your AI tools. No explaining your brand from scratch in every prompt, no output that sounds like everyone else. Best for founders and brand managers who don’t have the time (or enough AI shits to give) but need it done.',
    deliverables: ['AI brand and content audit', 'Your brand foundations built out into an AI-ready format you can import', 'A custom GPT or assistant, loaded with your brand and built in your own workspace', 'Prompt-ready voice and messaging files for your team'],
  },
];

const proof = [
  { name: 'Coworking-Retreat Startup', body: 'Brand manager from ideation through launch & scaling. Brand foundations, communications strategy & all content including website, blogs, videos, live presentations, plus community building.' },
  { name: 'Luxury Crystal Retail & Event Space', body: 'Brand foundations including visual and verbal identities, audience and competitor research, positioning, messaging. Launch comms and campaign strategies, and full content-suite including website and asset library creation.' },
  { name: 'Byron Bay Wellness Brand', body: 'Launch strategy, brand architecture, customer journeys, content creation and project management for a Byron Bay wellness brand readying its at-home infrared sauna range for market.' },
  { name: 'Rebrand & Launch', body: 'Full rebrand of an established and much-loved Australian herbal brand — new visual identity, brand language and positioning across all channels, paired with a complex dual-site build. Complete communications strategy for evolution without losing loyal base.' },
  { name: 'Strategic Branding Agency', body: "Embedded consultant working across Zadro's corporate client portfolio: positioning, messaging, brand language, channel and content strategy, campaign development, executive comms, social media and newsletters. A senior strategic voice scaled across multiple accounts." },
  { name: 'Regenerative Farming Equipment', body: 'Full brand foundations build for an Australian regenerative farming equipment business — audience and competitor research, verbal and visual identity, comms strategy, website, launch content and copy, social campaign assets, project management across the rollout.' },
  { name: 'Conservation Brand Architecture', body: 'Brand architecture, strategy, verbal and visual identity, comms strategy and PR for an Australian conservation not-for-profit and its two flagship initiatives, Rainforest Rangers and Save the Daintree.' },
  { name: 'Pasture-Raised Organic Eggs', body: 'Ongoing brand and communications consultancy for an Australian sustainable farming business — positioning, brand storytelling, content and channel comms for a pasture-raised organic egg producer in a category where genuine differentiation has to do real work.' },
  { name: 'Brand Foundations & Launch', body: 'Brand foundations build for Golf365: positioning, brand language, launch campaign strategy and content.' },
  { name: 'Mobile Social Engagement Platform', body: 'Led the communications function for a Barcelona-based mobile engagement tech platform — internal and external comms, PR, brand strategy and consistency, copy and content. Strategy and execution across a multinational team and a fast-moving product.' },
];

const logoFor = [
  ['coworkation', 'Coworkation'], ['quartz', 'Quartz'], ['helsi', 'Helsi'], ['happy-herb-co', 'Happy Herb Co'],
  ['zadro', 'Zadro'], ['tinkera', 'Tinkera'], ['gondwana', 'Gondwana Rainforest Trust, Rainforest Rangers and Save the Daintree'],
  ['olivers-hens', "Oliver's Hens"], ['golf365', 'Golf365 Performance Studio'], ['jet8', 'Jet8'],
];

const testimonials = [
  { quote: "Kirsty handled the brand building and launch of Golf365 with clarity and ease. She's strategic, creative, and good at translating founder! We launched with a structured and confident brand. I'd work with her again in a heartbeat.", who: 'Evie Graham, Founder,', org: [['Golf365 Performance Studio', 'https://www.facebook.com/golf365performancestudio/']] },
  { quote: "I've worked with Kirsty on two of my businesses. She's great at working out priorities and just getting the work done. She gets who I am and knows how to capture my vibe, but always with an eye on who we're actually trying to reach and what the business needs to achieve.", who: 'Oliver Bora, Founder,', org: [['Tinkera', 'https://www.tinkera.com.au'], ['Oliver’s Hens', 'https://www.olivershens.com']] },
  { quote: 'I had the pleasure of working with Kirsty for several years. Not only is she an absolute delight to work with, her strategic thinking and holistic approach to projects is so valuable. In addition, her curiosity and interest in broad topics and innovation is a real asset. I hope to work together again!', who: 'Marlise Beasley, General Manager/Account Director,', org: [['Zadro', 'https://www.zadroagency.com.au']] },
];
const proofCards = proof.map((p, i) => ({ ...p, logo: logoFor[i][0], alt: logoFor[i][1] }));
---
<Base
  title="Brand Strategy & Brand Foundations Projects — Punk Lotus"
  description="Brand foundations, rebrands, launch strategy and AI-ready brand systems — fixed-scope 3–6 month projects for Australian businesses, delivered remotely. Start with a $350 Brand Gut-Check."
>
  <Hero
    title="The Work"
    sub="Brand and communications projects, scoped to fit. Three to six months, priced up front, then handed over."
  >
    <a class="btn" href="#contact">Enquire Now</a>
    <a class="btn btn--ghost" href="#gut-check">Or start with a Gut-Check</a>
  </Hero>

  <Marquee items={['Discovery', 'Strategy', 'Brand foundations', 'Set-up', 'Handover']} />

  <div id="gut-check"><GutCheck /></div>

  <section class="section section--light">
    <div class="wrap split">
      <div class="stick reveal">
        <h2>Services scoped to fit.</h2>
        <p>Each one runs as its own project, with a clear scope, a fixed price and an end date.</p>
      </div>
      <div class="services reveal">
        {services.map((s) => (
          <details class="service">
            <summary><h3>{s.name}</h3><span class="toggle" aria-hidden="true"></span></summary>
            <div class="service-body">
              <p>{s.body}</p>
              <p class="label">Common deliverables:</p>
              <ul>{s.deliverables.map((d) => <li>{d}</li>)}</ul>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <h2 class="reveal">Proof.</h2>
      <Carousel label="Proof: brand work" perView={3}>
        {proofCards.map((p) => (
          <li class="card">
            <img src={`/images/clients/${p.logo}.png`} alt={p.alt} loading="lazy" width="160" height="160" />
            <h3>{p.name}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </Carousel>
    </div>
  </section>

  <section class="section section--orange">
    <div class="wrap">
      <Carousel label="Testimonials" perView={2}>
        {testimonials.map((t) => (
          <li>
            <figure>
              <blockquote><p>“{t.quote}”</p></blockquote>
              <figcaption>{t.who} {t.org.map(([n, url], i) => <>{i > 0 && ', '}<a href={url} rel="noopener">{n}</a></>)}</figcaption>
            </figure>
          </li>
        ))}
      </Carousel>
    </div>
  </section>

  <section class="section section--cream" id="contact">
    <div class="wrap split reveal">
      <div>
        <h2>Let’s Talk</h2>
        <p>Send a few lines about your business and what you're trying to figure out, and I'll come back to set up a call.</p>
        <p><a href="mailto:kt@punklotus.com">kt@punklotus.com</a><br /><a href="tel:+61468825419">+61 (0)468 825 419</a></p>
      </div>
      <ContactForm name="enquiry" variant="enquiry" />
    </div>
  </section>
</Base>

<style>
  .services { border-top: 3px solid var(--charcoal); }
  .service { border-bottom: 3px solid var(--charcoal); }
  summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 0; transition: color .15s ease, padding .15s ease; }
  summary:hover { color: var(--orange-deep); padding-left: 8px; }
  summary::-webkit-details-marker { display: none; }
  summary h3 { margin: 0; }
  summary:focus-visible { outline: 3px solid var(--orange); outline-offset: 4px; }
  .toggle { flex: none; width: 22px; height: 22px; position: relative; }
  .toggle::before, .toggle::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 3px; margin-top: -1.5px; background: currentColor; transition: transform .2s; }
  .toggle::after { transform: rotate(90deg); }
  details[open] .toggle::after { transform: rotate(0deg); }
  details[open] summary { color: var(--orange-deep); }
  .service-body { padding-bottom: 24px; }
  .label { font-family: var(--font-ui); font-weight: 700; margin-bottom: .4em; }
  .service ul { margin: 0; padding-left: 1.2em; }
  .card { background: var(--cream-light); padding: 24px; height: 100%; border-top: 4px solid var(--orange); transition: transform .2s ease, box-shadow .2s ease; }
  .card:hover { transform: translate(-4px, -4px); box-shadow: 4px 4px 0 var(--charcoal); }
  .card img { width: 120px; height: 120px; object-fit: contain; margin-bottom: 16px; }
  .card h3 { font-size: 1.05rem; }
  .card p { font-size: .92rem; margin: 0; }
  figure { margin: 0; }
  blockquote { margin: 0 0 1em; font-size: clamp(1.05rem, 2vw, 1.35rem); }
  figcaption { font-family: var(--font-ui); font-weight: 700; }
  @media (prefers-reduced-motion: reduce) { .card, summary, .toggle::before, .toggle::after { transition: none; } .card:hover { transform: none; } }
</style>
